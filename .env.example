# --- Postgres (consumed by docker-compose + Prisma) ---
POSTGRES_USER=rent
POSTGRES_PASSWORD=rent
POSTGRES_DB=rent_scraper
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rent:rent@localhost:5432/rent_scraper?schema=public

# --- Filters ---
FILTER_DISTRICTS=Mokotów,Wola,Praga

# --- Proxy file (one proxy per line: IP:PORT:USER:PASS) ---
PROXY_FILE=./proxy.txt

# --- ORS ---
ORS_API_KEY=

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# --- Nominatim (required by their TOS) ---
NOMINATIM_USER_AGENT=rent-scraper/1.0 (contact: you@example.com)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# --- Discord / Sheets (wired later) ---
DISCORD_WEBHOOK_URL=
GOOGLE_SHEETS_ID=
GOOGLE_SA_JSON=

#Optional:
SHEET_NAME=
